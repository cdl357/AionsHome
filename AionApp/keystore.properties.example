# 复制为 AionApp/keystore.properties 后填入真实值。
# keystore.properties 与 *.jks / *.keystore 都不入库，务必自行备份密钥文件：
# 签名一旦丢失，升级安装会失败，只能卸载重装。
#
# 生成新 keystore（在 AionApp/ 目录下执行）：
#   keytool -genkeypair -v -keystore aion-release.jks -alias aion \
#       -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile 相对于 AionApp/ 目录，也可以是绝对路径。
storeFile=aion-release.jks
storePassword=CHANGE_ME
keyAlias=aion
keyPassword=CHANGE_ME
